  "narrative": {
    "overview": "The incumbent world is warm gold, cream, white and Poppins. The approved dashboard adaptation adds generous rounded panels, eggs and the existing chicken mascot to the fitness reference\u2019s composition. This records the implementation; it does not establish an unconfirmed brand metaphor.\n\nThe shell and dashboard use broad tonal regions around compact operational records. Login remains governed by its preserved surface brief. Financial values and health states retain explicit labels alongside color.",
    "keyCharacteristics": [
      "Warm neutral backgrounds and gold accents.",
      "Rounded operational panels with poultry imagery.",
      "Compact Poppins labels and prominent tabular financial values.",
      "Small ambient and interactive movements with reduced-motion support."
    ],
    "rules": [
      {
        "name": "The Labeled State Rule",
        "body": "Keep financial signs, state labels and explanatory text alongside color.",
        "section": "colors"
      }
    ],
    "dos": [
      "**Do** preserve Poppins, warm neutrals and established gold actions when extending existing screens.",
      "**Do** keep daily recorded P&L visibly distinct from closed-batch profit.",
      "**Do** preserve visible keyboard focus and the reduced-motion behavior."
    ],
    "donts": [
      "**Don't** make color the sole carrier of financial or health state.",
      "**Don't** treat the dashboard\u2019s small calendar annotations as the global body size.",
      "**Don't** replace the existing chicken image or its provenance as part of routine surface work."
    ]
  }
}
