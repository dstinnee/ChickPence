# ChickPence Environment Variables
# Every variable is optional. Restart `npm run dev` after changing this file.

# Supabase (cloud sync and real accounts).
# If left empty, ChickPence runs in local offline Demo mode with IndexedDB (Dexie.js).
# Local Supabase (`npx supabase start`): http://127.0.0.1:54321 and the anon key from `npx supabase status`.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Local AI for logbook scanning (Ollama). Defaults shown; leave empty to use them.
VITE_OLLAMA_URL=
VITE_OLLAMA_OCR_MODEL=
VITE_OLLAMA_TEXT_MODEL=

# Hosted ChickCount image-counting endpoint (multipart POST, field: image).
# Keep provider API keys on the server, never in VITE_ variables.
VITE_CHICKCOUNT_API_URL=

# Enable the Instant Demo button in a production preview build (always shown in development).
VITE_DEMO_MODE=false
